<?xml version="1.0" encoding="UTF-8"?>

<configuration>

    <!-- Enable Logback initialization logs (remove after verification) -->
    <statusListener class="ch.qos.logback.core.status.OnConsoleStatusListener"/>

    <property name="LOG_PATH" value="logs"/>

    <!-- Reads logging.file.path from application.yml -->
<!--    <springProperty-->
<!--            scope="context"-->
<!--            name="LOG_PATH"-->
<!--            source="logging.file.path"/>-->

    <property name="LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level [%X{X-Correlation-ID}] %logger{40} - %msg%n%ex"/>

    <!-- ===================== CONSOLE ===================== -->

    <appender name="CONSOLE"
              class="ch.qos.logback.core.ConsoleAppender">

        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>

    </appender>

    <!-- ================= APPLICATION ==================== -->

    <appender name="APPLICATION"
              class="ch.qos.logback.core.rolling.RollingFileAppender">

        <file>${LOG_PATH}/payflow_application.log</file>

        <append>true</append>

        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>

        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">

            <fileNamePattern>
                ${LOG_PATH}/payflow_application.%d{yyyy-MM-dd}.%i.log.gz
            </fileNamePattern>

            <maxFileSize>10MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
            <cleanHistoryOnStart>true</cleanHistoryOnStart>

        </rollingPolicy>

    </appender>

    <!-- ================= SECURITY ==================== -->

    <appender name="SECURITY"
              class="ch.qos.logback.core.rolling.RollingFileAppender">

        <file>${LOG_PATH}/payflow_security.log</file>

        <append>true</append>

        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>

        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">

            <fileNamePattern>
                ${LOG_PATH}/payflow_security.%d{yyyy-MM-dd}.%i.log.gz
            </fileNamePattern>

            <maxFileSize>10MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>500MB</totalSizeCap>
            <cleanHistoryOnStart>true</cleanHistoryOnStart>

        </rollingPolicy>

    </appender>

    <!-- ================= SCHEDULER ==================== -->

    <appender name="SCHEDULER"
              class="ch.qos.logback.core.rolling.RollingFileAppender">

        <file>${LOG_PATH}/payflow_cronjob_scheduler.log</file>

        <append>true</append>

        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>

        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">

            <fileNamePattern>
                ${LOG_PATH}/payflow_cronjob_scheduler.%d{yyyy-MM-dd}.%i.log.gz
            </fileNamePattern>

            <maxFileSize>10MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>200MB</totalSizeCap>
            <cleanHistoryOnStart>true</cleanHistoryOnStart>

        </rollingPolicy>

    </appender>

    <!-- ================= LOGGERS ==================== -->

    <logger name="com.rochak.payflow.security"
            level="INFO"
            additivity="false">

        <appender-ref ref="SECURITY"/>

    </logger>

    <logger name="com.rochak.payflow.cronjob"
            level="INFO"
            additivity="false">

        <appender-ref ref="SCHEDULER"/>

    </logger>

    <!-- ================= ROOT ==================== -->

    <root level="INFO">

        <appender-ref ref="CONSOLE"/>

        <appender-ref ref="APPLICATION"/>

    </root>

</configuration>